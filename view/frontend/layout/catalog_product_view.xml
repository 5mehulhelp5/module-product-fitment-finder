<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <!--
            v1.1.0: PDP fitment badge. Renders "Fits: BMW 3 Series 2018-2023"
            inline after the price. Block returns empty HTML if the merchant
            opted out, the product has no vehicle_compat_data, or none of the
            referenced Makes can be resolved. Theme-agnostic — same template
            on Hyvä, Luma, and any custom theme.
        -->
        <referenceBlock name="product.info.main">
            <!--
                Anchor to the "product.info" add-to-cart form block (a guaranteed
                direct child of product.info.main). The core "product.info.price"
                container gets relocated under that form block by other layout,
                so referencing it here crossed parents and Magento rejected the
                placement ("Broken reference … parents are different"), leaving the
                badge unrendered. "after=product.info" keeps a same-parent sibling
                reference so the badge always renders, just below the price/add-to-cart.
            -->
            <block class="ETechFlow\ProductFitmentFinder\Block\Product\FitmentBadge"
                   name="etechflow.vc.pdp.fitment"
                   template="ETechFlow_ProductFitmentFinder::product/fitment-badge.phtml"
                   after="product.info"/>
            <!--
                Part Finder form on the product page. Renders only when
                Part Finder Placement = "Product Page" (gated via vc_location).
            -->
            <block class="ETechFlow\ProductFitmentFinder\Block\Widget\PartFinder"
                   name="vehiclecompat.product.partfinder"
                   template="ETechFlow_ProductFitmentFinder::partfinder/widget.phtml"
                   after="etechflow.vc.pdp.fitment">
                <arguments>
                    <argument name="vc_location" xsi:type="string">product</argument>
                    <argument name="vc_size" xsi:type="string">sm</argument>
                </arguments>
            </block>
            <!-- My Garage travels with the finder (Placement = Product Page). -->
            <block class="ETechFlow\ProductFitmentFinder\Block\Garage"
                   name="vehiclecompat.product.garage"
                   template="ETechFlow_ProductFitmentFinder::garage/widget.phtml"
                   after="vehiclecompat.product.partfinder">
                <arguments>
                    <argument name="vc_location" xsi:type="string">product</argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>
